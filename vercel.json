{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.ts"
    }
  },
  "rewrites": [
    {
      "source": "/assets/:match*",
      "destination": {
        "service": "frontend",
        "path": "/assets/:match*"
      }
    },
    {
      "source": "/api/:match*",
      "destination": {
        "service": "backend",
        "path": "/api/:match*"
      }
    },
    {
      "source": "/:match*",
      "destination": {
        "service": "frontend",
        "path": "/"
      }
    }
  ]
}
