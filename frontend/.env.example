# TERANGA FOOD - Frontend Environment Variables
# En local, vous pouvez laisser vide : fallback automatique sur http://localhost:5000
# Sur Vercel, définissez ces variables dans Project Settings > Environment Variables

# URL de l'API Backend REST
VITE_API_URL=http://localhost:5000

# URL du serveur WebSocket Socket.IO (optionnel si identique à VITE_API_URL)
VITE_WS_URL=http://localhost:5000
